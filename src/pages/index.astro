---
import ThemeToggle from '../components/ui/ThemeToggle';
import App from '../App';
import ChatBot from '../components/chat/ChatBot';
import Footer from '../components/layout/Footer.astro';
import '../styles/index.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nicholas Method 81 | Mining Method Selection</title>

    <meta
      name="description"
      content="Evaluate and recommend optimal mining methods using a numerical approach based on deposit geometry and geomechanical conditions."
    />
    <meta
      name="keywords"
      content="nicholas method, mining method selection, underground mining, geomechanics, engineering software"
    />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large"
    />
    <meta name="author" content="LuiccianDev" />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Nicholas Method 81 | Mining Method Selection"
    />
    <meta
      property="og:description"
      content="Evaluate and recommend optimal mining methods using a numerical approach based on deposit geometry and geomechanical conditions."
    />
    <meta property="og:image" content="/banner.png" />
    <meta property="og:site_name" content="Nicholas Method 81" />

    <script is:inline>
      (function () {
        try {
          var storedTheme = window.localStorage.getItem('theme');
          var resolvedTheme;
          if (
            storedTheme === 'dark' ||
            (!storedTheme &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            resolvedTheme = 'dark';
            document.documentElement.classList.add('dark');
          } else {
            resolvedTheme = 'light';
            document.documentElement.classList.add('light');
          }
          window.__INITIAL_THEME__ = resolvedTheme;
        } catch (e) {
          window.__INITIAL_THEME__ = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <div
      class="flex min-h-dvh w-full flex-col overflow-x-hidden bg-surface font-sans text-foreground"
    >
      <div
        class="mx-auto flex w-full max-w-400 flex-1 flex-col px-4 py-4 md:px-8 md:py-6"
      >
        <header
          class="mb-6 flex flex-col items-start justify-between gap-4 border-b border-border pb-5 md:flex-row md:items-end"
          id="top"
        >
          <div class="max-w-xl">
            <p
              class="mb-2 font-mono text-xxs tracking-widest text-primary uppercase"
            >
              Mining Method Advisor
            </p>
            <h1
              class="font-serif text-3xl leading-none font-bold tracking-tight text-foreground italic md:text-5xl"
            >
              Nicholas Selector<span class="text-primary">.</span>
            </h1>
          </div>
          <div
            class="flex w-full flex-col items-start gap-x-8 gap-y-3 md:w-auto md:flex-row md:items-end"
          >
            <ThemeToggle client:idle />
            <div class="text-left md:text-right">
              <p class="font-mono text-xs text-foreground-muted">
                REF: DAVID E. NICHOLAS / OPTIMIZATION ENGINE
              </p>
              <p class="font-mono text-xs text-foreground-muted">
                EST. 1981 / ROCK MECHANICS
              </p>
            </div>
          </div>
        </header>

        <App client:load />
      </div>

      <Footer />

      <ChatBot client:idle />
    </div>
  </body>
</html>
