---
import App from '../App';
import ChatBot from '../components/chat/ChatBot';
import Footer from '../components/layout/Footer';
import Header from '../components/layout/Header';
import Landing from '../components/landing/Landing';
import '../styles/index.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nicholas Method 81 | Mining Method Selection</title>

    <meta
      name="description"
      content="Evaluate and recommend optimal mining methods using a numerical approach based on deposit geometry and geomechanical conditions."
    />
    <meta
      name="keywords"
      content="nicholas method, mining method selection, underground mining, geomechanics, engineering software"
    />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large"
    />
    <meta name="author" content="LuiccianDev" />

    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content="Nicholas Method 81 | Mining Method Selection"
    />
    <meta
      property="og:description"
      content="Evaluate and recommend optimal mining methods using a numerical approach based on deposit geometry and geomechanical conditions."
    />
    <meta property="og:image" content="/banner.png" />
    <meta property="og:site_name" content="Nicholas Method 81" />

    <script is:inline>
      (function () {
        try {
          var storedTheme = window.localStorage.getItem('theme');
          var resolvedTheme;
          if (
            storedTheme === 'dark' ||
            (!storedTheme &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          ) {
            resolvedTheme = 'dark';
            document.documentElement.classList.add('dark');
          } else {
            resolvedTheme = 'light';
            document.documentElement.classList.add('light');
          }
          window.__INITIAL_THEME__ = resolvedTheme;
        } catch (e) {
          window.__INITIAL_THEME__ = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <div
      class="flex min-h-dvh w-full flex-col overflow-x-hidden bg-surface font-sans text-foreground"
    >
<!--       <div
        class="mx-auto flex w-full max-w-400 flex-1 flex-col px-4 py-4 md:px-8 md:py-6"
      >
        <Header client:load />
        <App client:load />
        
        <Footer client:load />
      </div> -->
<Landing client:load />
      <ChatBot client:idle />
    </div>
  </body>
</html>
